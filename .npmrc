# Expo requires a flat node_modules in pnpm monorepos. Do not remove.
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false
# Pin the content-addressable store inside the repo (gitignored) so sandboxed and unsandboxed
# pnpm runs agree on it; the sandbox cannot read ~/.npmrc, which otherwise decides the store.
store-dir=.pnpm-store
