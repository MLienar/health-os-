    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^13.3.0",
    "react-test-renderer": "19.2.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0"
  }
