{
  "expo": {
    "name": "health-os",
    "slug": "health-os",
    "version": "0.1.0",
    "scheme": "diettracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0b0f14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.sahar.diettracker"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
